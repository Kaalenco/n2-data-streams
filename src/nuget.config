<?xml version="1.0" encoding="utf-8"?>
<!--
  Package sources for n2-data-streams.

  vault-packages is a private Azure Artifacts feed for the N2.* packages. NO credentials
  belong in this file:
    - local dev: Azure Artifacts Credential Provider (interactive sign-in), or
      dotnet nuget update source ... in your user-level NuGet.Config;
    - CI (GitHub Actions): a read-only Packaging PAT in the repository secret NUGET_PAT,
      added to this source on the runner only (see .github/workflows/dotnet.yml).

  Package source mapping keeps N2.* on the private feed and everything else on nuget.org,
  so restore never asks nuget.org for N2.* (dependency confusion) and never asks the
  private feed for public packages.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="vault-packages" value="https://pkgs.dev.azure.com/gjkaal/N2%20Vault%20services/_packaging/vault-packages/nuget/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="vault-packages">
      <package pattern="N2.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
